rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "niharikakaladev@gmail.com"
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Wallets: Read-only for users. All writes must go through Firebase Admin SDK / Cloud Functions
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Block client-side balance manipulation!
      allow write: if isAdmin();
    }

    // Transactions: Users can only read their own transactions
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Withdrawals
    match /withdrawals/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users can submit a request (or use secure callable function)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only Admin can update status (Approve / Reject)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Game Results & Spin History
    match /spin_history/{spinId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /game_results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // System Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
